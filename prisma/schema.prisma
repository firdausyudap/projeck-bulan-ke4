generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VerificationStatus {
  VERIFIED
  INTERPRETED
  ORAL_TRADITION
  LEGEND
  DISPUTED
  NEEDS_RESEARCH
}

enum RelationType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookmarks    Bookmark[]
  articles     Article[] @relation("ArticleAuthor")

  @@index([email])
  @@index([role])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles     Article[]
  inscriptions Inscription[]

  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles  ArticleTag[]

  @@index([slug])
}


model Article {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      ContentStatus  @default(DRAFT)
  viewCount   Int            @default(0)
  authorId    String
  categoryId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  publishedAt DateTime?

  author      User           @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        ArticleTag[]
  bookmarks   Bookmark[]
  media       Media[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
}

model ArticleTag {
  articleId  String
  tagId      String
  assignedAt DateTime @default(now())

  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag        Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
}


model King {
  id                 String             @id @default(cuid())
  name               String
  title              String?
  slug               String             @unique
  reignStart         String?
  reignEnd           String?
  birthYear          String?
  deathYear          String?
  birthPlace         String?
  deathPlace         String?
  description        String
  biography          String?
  achievements       String?
  verificationStatus VerificationStatus @default(NEEDS_RESEARCH)
  sourceNote         String?
  portraitUrl        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  relationsFrom      FamilyRelation[]   @relation("RelationFrom")
  relationsTo        FamilyRelation[]   @relation("RelationTo")
  media              Media[]

  @@index([slug])
  @@index([name])
}

model FamilyRelation {
  id                 String             @id @default(cuid())
  fromKingId         String
  toKingId           String
  relationType       RelationType
  description        String?
  verificationStatus VerificationStatus @default(NEEDS_RESEARCH)
  sourceNote         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  fromKing           King               @relation("RelationFrom", fields: [fromKingId], references: [id], onDelete: Cascade)
  toKing             King               @relation("RelationTo", fields: [toKingId], references: [id], onDelete: Cascade)

  @@index([fromKingId])
  @@index([toKingId])
  @@index([relationType])
}

model Inscription {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  location             String?
  discoveryLocation    String?
  dateEstimate         String?
  script               String?
  language             String?
  transliteration      String?
  translation          String?
  description          String
  historicalContext    String?
  verificationStatus   VerificationStatus @default(NEEDS_RESEARCH)
  sourceNote           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  categoryId           String?
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media                Media[]

  @@index([slug])
  @@index([name])
  @@index([categoryId])
}

model Media {
  id               String    @id @default(cuid())
  title            String
  url              String
  type             MediaType
  altText          String?
  caption          String?
  credit           String?
  source           String?
  license          String?
  fileSize         Int?
  mimeType         String?
  width            Int?
  height           Int?
  duration         Int?
  isIllustration   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  articleId        String?
  article          Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  kingId           String?
  king             King?     @relation(fields: [kingId], references: [id], onDelete: SetNull)
  inscriptionId    String?
  inscription      Inscription? @relation(fields: [inscriptionId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([articleId])
  @@index([kingId])
  @@index([inscriptionId])
}

