{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "installCommand": "npm --prefix ../.. install",
      "buildCommand": "npm --prefix ../.. run prisma:generate && npm --prefix ../.. run build:api"
    },
    "python-service": {
      "root": "apps/python-service",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "npm --prefix ../.. install",
      "buildCommand": "npm --prefix ../.. run build:web"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
