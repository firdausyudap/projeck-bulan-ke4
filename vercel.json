{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api/",
      "framework": "express",
      "entrypoint": "api/index.ts",
      "installCommand": "npm ci --prefix \"$(git rev-parse --show-toplevel)\" --workspaces --include-workspace-root",
      "buildCommand": "npm exec --workspace=@pajajaran/api -- prisma generate --schema ../../prisma/schema.prisma && npm run build --workspace=@pajajaran/shared && npm run build --workspace=@pajajaran/api"
    },
    "python-service": {
      "root": "apps/python-service/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "web": {
      "root": "apps/web/",
      "framework": "vite",
      "installCommand": "npm ci --prefix \"$(git rev-parse --show-toplevel)\" --workspaces --include-workspace-root",
      "buildCommand": "npm run build --workspace=@pajajaran/web",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/python-service/(.*)",
      "destination": {
        "service": "python-service"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
